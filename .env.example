# AI Provider API Keys
#
# 支持三种 Provider，通过 DEFAULT_AI_PROVIDER 切换：
#   volcengine - 火山引擎 ARK（默认，国内可用，OpenAI 兼容格式）
#   openai     - OpenAI 官方或任意 OpenAI 兼容端点（DeepSeek 官方 / 通义千问 / Kimi / Ollama 等）
#   claude     - Anthropic Claude（官方 OpenAI 兼容端点）

# 火山引擎（推荐，国内可用）
VOLCENGINE_API_KEY=你的火山引擎_api_key
VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/plan/v3
VOLCENGINE_MODEL=deepseek-v4-flash

# OpenAI / OpenAI 兼容端点（DEFAULT_AI_PROVIDER=openai 时使用）
# 任何 OpenAI 兼容服务都可接入：把 OPENAI_BASE_URL 换成对应地址、OPENAI_MODEL 换成对应模型即可
OPENAI_API_KEY=你的_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Claude（DEFAULT_AI_PROVIDER=claude 时使用）
# CLAUDE_API_KEY 与 ANTHROPIC_API_KEY 二选一（后者为兼容别名）
CLAUDE_API_KEY=你的_claude_api_key
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-sonnet-4-20250514

# 默认 AI 提供商（volcengine / openai / claude）
DEFAULT_AI_PROVIDER=volcengine
